        list(${_ph_insert} _ph_shared_layouts "${_ph_config}")
        list(${_ph_insert} _ph_static_layouts "${_ph_config}/static" "static/${_ph_config}")
    endforeach()
    if(PH_ONLINE_JIT_PREFER_SHARED)
        set(_ph_linkages shared static)
