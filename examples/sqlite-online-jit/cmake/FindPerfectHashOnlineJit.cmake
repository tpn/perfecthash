function(_ph_owned_dirs output variable root)
    get_filename_component(root "${root}" ABSOLUTE)
    string(TOLOWER "${root}" root_lower)
    file(TO_CMAKE_PATH "$ENV{${variable}}" env_dirs)
    set(found)
    foreach(dir IN LISTS ${variable} env_dirs)
        get_filename_component(dir "${dir}" ABSOLUTE)
        string(TOLOWER "${dir}" dir_lower)
        cmake_path(IS_PREFIX root_lower "${dir_lower}" NORMALIZE owned)
        if(owned)
            list(APPEND found "${dir}")
        endif()
    endforeach()
    set(${output} "${found}" PARENT_SCOPE)
endfunction()

