# Stage this executable's runtime and retire only its own unmodified copies.
cmake_minimum_required(VERSION 3.20)
string(SHA256 directory_id "${destination}")
set(manifest "${state_dir}/${directory_id}.txt")
file(MAKE_DIRECTORY "${destination}" "${state_dir}")
set(previous)
if(EXISTS "${manifest}")
    file(STRINGS "${manifest}" previous ENCODING UTF-8)
endif()
list(TRANSFORM previous TOLOWER OUTPUT_VARIABLE previous_keys)
set(current)
set(selected)
foreach(source IN LISTS files)
    if(NOT source)
        continue()
    endif()
    get_filename_component(name "${source}" NAME)
    string(TOLOWER "${name}" key)
    list(APPEND selected "${key}")
    set(output "${destination}/${name}")
    file(SHA256 "${source}" digest)
    set(entry "${digest} ${name}")
    if(EXISTS "${output}")
        file(SHA256 "${output}" installed_digest)
        if(installed_digest STREQUAL digest)
            file(REAL_PATH "${source}" source_path)
            file(REAL_PATH "${output}" output_path)
            string(TOLOWER "${source_path}" source_path)
            string(TOLOWER "${output_path}" output_path)
            set(entry_key "${digest} ${key}")
            if(entry_key IN_LIST previous_keys AND NOT source_path STREQUAL output_path)
                list(APPEND current "${entry}")
            endif()
            continue()
        endif()
    endif()
    # Record the intended copy so a retry can finish a partially staged set.
    file(APPEND "${manifest}" "\n${entry}\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${source}" "${output}" COMMAND_ERROR_IS_FATAL ANY)
    list(APPEND current "${entry}")
endforeach()
foreach(entry IN LISTS previous)
    if(entry MATCHES "^([0-9a-f]+) ([^/\\\\]+)$")
        set(expected "${CMAKE_MATCH_1}")
        set(name "${CMAKE_MATCH_2}")
        string(TOLOWER "${name}" key)
        set(path "${destination}/${name}")
        if(NOT key IN_LIST selected AND EXISTS "${path}" AND NOT IS_DIRECTORY "${path}")
            file(SHA256 "${path}" actual)
            if(actual STREQUAL expected)
                file(REMOVE "${path}")
            endif()
        endif()
    endif()
endforeach()
set(plugin "${destination}/PerfectHashLLVM.dll")
if(NOT "perfecthashllvm.dll" IN_LIST selected AND EXISTS "${plugin}" AND NOT IS_DIRECTORY "${plugin}")
    file(SHA256 "${plugin}" digest)
    set(untracked "untracked-plugin ${digest}")
    if(NOT untracked IN_LIST previous)
        message(WARNING "Found an untracked plugin at ${plugin}. The selected SDK supplies no LLVM plugin "
            "for this executable. If this copy came from a previous SDK, move it out of the executable directory and rebuild.")
    endif()
    list(APPEND current "${untracked}")
endif()
list(JOIN current "\n" contents)
file(WRITE "${manifest}.tmp" "${contents}")
file(RENAME "${manifest}.tmp" "${manifest}")
