# Stage this executable's runtime and retire only its own unmodified copies.
cmake_minimum_required(VERSION 3.20)
string(SHA256 directory_id "${destination}")
set(manifest "${state_dir}/${directory_id}.txt")
set(previous)
if(EXISTS "${manifest}")
    file(STRINGS "${manifest}" previous ENCODING UTF-8)
endif()
list(TRANSFORM previous TOLOWER OUTPUT_VARIABLE previous_keys)
list(FILTER files EXCLUDE REGEX "^$")
list(REMOVE_DUPLICATES files)
set(selected)
set(digests)
foreach(source IN LISTS files)
    file(SHA256 "${source}" digest)
    list(APPEND digests "${digest}")
    get_filename_component(name "${source}" NAME)
    list(APPEND selected "${name}")
endforeach()
list(TRANSFORM selected TOLOWER)
set(plugin "${destination}/PerfectHashLLVM.dll")
if(NOT "perfecthashllvm.dll" IN_LIST selected AND EXISTS "${plugin}" AND NOT IS_DIRECTORY "${plugin}")
    file(SHA256 "${plugin}" digest)
    if(NOT "${digest} perfecthashllvm.dll" IN_LIST previous_keys)
        message(FATAL_ERROR "An untracked plugin at ${plugin} could be loaded by this executable. "
            "Move it out of the executable directory and rebuild. To use it with a local SDK, "
            "configure with -DPERFECTHASH_ONLINE_JIT_LLVM_RUNTIME_DLL=\"${plugin}\".")
    endif()
endif()

set(obsolete)
foreach(entry IN LISTS previous)
    if(entry MATCHES "^([0-9a-f]+) ([^/\\\\]+)$")
        set(expected "${CMAKE_MATCH_1}")
        set(name "${CMAKE_MATCH_2}")
        string(TOLOWER "${name}" key)
        set(path "${destination}/${name}")
        if(NOT key IN_LIST selected AND EXISTS "${path}" AND NOT IS_DIRECTORY "${path}")
            file(SHA256 "${path}" actual)
            if(actual STREQUAL expected)
                list(APPEND obsolete "${path}")
            endif()
        endif()
    endif()
endforeach()

file(MAKE_DIRECTORY "${destination}" "${state_dir}")
set(current)
set(copy_sources)
set(copy_outputs)
foreach(source digest IN ZIP_LISTS files digests)
    get_filename_component(name "${source}" NAME)
    set(output "${destination}/${name}")
    set(entry "${digest} ${name}")
    if(EXISTS "${output}")
        file(SHA256 "${output}" installed_digest)
        if(installed_digest STREQUAL digest)
            file(REAL_PATH "${source}" source_path)
            file(REAL_PATH "${output}" output_path)
            string(TOLOWER "${source_path}" source_path)
            string(TOLOWER "${output_path}" output_path)
            string(TOLOWER "${entry}" entry_key)
            if(entry_key IN_LIST previous_keys AND NOT source_path STREQUAL output_path)
                list(APPEND current "${entry}")
            endif()
            continue()
        endif()
    endif()
    list(APPEND copy_sources "${source}")
    list(APPEND copy_outputs "${output}")
    list(APPEND current "${entry}")
endforeach()

# Prepare new bytes before modifying the executable directory's active DLLs.
# Backups live beside the DLLs so every move uses a same-volume rename.
string(RANDOM LENGTH 24 transaction)
set(replace ${obsolete})
foreach(output IN LISTS copy_outputs)
    if(EXISTS "${output}")
        list(APPEND replace "${output}")
    endif()
endforeach()
list(REMOVE_DUPLICATES replace)
set(move_from)
set(move_to)
set(backups)
foreach(path IN LISTS replace)
    set(backup "${path}.${transaction}.retired")
    list(APPEND backups "${backup}")
    list(APPEND move_from "${path}")
    list(APPEND move_to "${backup}")
endforeach()
list(JOIN current "\n" contents)
set(pending_manifest "${manifest}.${transaction}.tmp")
file(WRITE "${pending_manifest}" "${contents}")
set(temporary "${pending_manifest}")
foreach(source output IN ZIP_LISTS copy_sources copy_outputs)
    set(incoming "${output}.${transaction}.new")
    list(APPEND temporary "${incoming}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy "${source}" "${incoming}"
        RESULT_VARIABLE error)
    if(error)
        file(REMOVE ${temporary})
        message(FATAL_ERROR "Could not prepare the selected runtime ${source}.")
    endif()
    list(APPEND move_from "${incoming}")
    list(APPEND move_to "${output}")
endforeach()
# Publish the manifest last. Undo completed moves in reverse order if any
# rename fails, including a sharing violation on an obsolete or replaced DLL.
list(APPEND move_from "${pending_manifest}")
list(APPEND move_to "${manifest}")
set(undo_from)
set(undo_to)
foreach(source output IN ZIP_LISTS move_from move_to)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E rename "${source}" "${output}"
        RESULT_VARIABLE error)
    if(error)
        set(restore_errors "")
        foreach(saved original IN ZIP_LISTS undo_from undo_to)
            execute_process(COMMAND "${CMAKE_COMMAND}" -E rename "${saved}" "${original}"
                RESULT_VARIABLE restore_error)
            if(restore_error)
                string(APPEND restore_errors "\nCould not restore ${original} from ${saved}.")
            endif()
        endforeach()
        file(REMOVE ${temporary})
        message(FATAL_ERROR "Could not stage the runtime set while moving ${source} to ${output}. "
            "Close any process using these files and rebuild.${restore_errors}")
    endif()
    list(PREPEND undo_from "${output}")
    list(PREPEND undo_to "${source}")
endforeach()
if(backups)
    file(REMOVE ${backups})
endif()
